# ── Windows Server notes ──────────────────────────────────────────────────────
# Run with Docker Desktop or Docker Engine for Windows (Linux containers mode).
# Ensure Docker is configured to use Linux containers (the default).
# Set PYTHONIOENCODING=utf-8 in your shell environment before running
# docker compose commands to avoid encoding errors on Windows consoles.
# Use:  docker compose -f docker-compose.yml -f docker-compose.windows.yml up
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
# development | production. Unset = production (no API docs, https-only cookies);
# any other value fails at startup. Use development only for local work.
APP_ENV=development
APP_SECRET_KEY=change-me-to-a-random-64-char-hex-string
APP_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=jhans
POSTGRES_USER=jhans
POSTGRES_PASSWORD=change-me

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── MinIO ────────────────────────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me
MINIO_BUCKET_RESUMES=jhans-resumes
MINIO_SECURE=false

# ── Encryption ───────────────────────────────────────────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=change-me-generate-with-fernet

# ── OAuth Providers ──────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Microsoft External ID (inactive at launch — scaffold only)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=

# ── LLM ──────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ── Notifications ────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# Email (SendGrid or SMTP)
EMAIL_PROVIDER=smtp
SENDGRID_API_KEY=
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@jhans.local

# ── Security ─────────────────────────────────────────────────────────────────
# Admin IP allowlist — enforced on every /api/admin/* route (403 otherwise),
# checked before admin authentication and role checks.
# - Comma-separated, exact IP match (no CIDR ranges, no wildcards).
# - EMPTY = FAIL CLOSED: an empty value blocks ALL admin access. There is no
#   "allow any" setting.
# - The IP checked is the one uvicorn sees. Under Docker port-mapping that is
#   usually the compose network gateway (e.g. 172.18.0.1), not 127.0.0.1.
# - IPv6 is matched literally: a dual-stack bind reports loopback as ::1 or
#   ::ffff:127.0.0.1, which must be listed explicitly.
# - Behind nginx (docker-compose.prod.yml) uvicorn trusts X-Forwarded-For only
#   from nginx's fixed address 172.28.0.10, so list the real admin client IPs.
#   NEVER list the proxy's own address in ALLOWED_IPS: that allows every
#   internet client. NEVER set FORWARDED_ALLOW_IPS=*: uvicorn then trusts the
#   client-supplied X-Forwarded-For and the allowlist can be spoofed.
ALLOWED_IPS=127.0.0.1
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=4
TOTP_ISSUER=jH_ANS

# ── Crawling ─────────────────────────────────────────────────────────────────
CRAWL_MAX_CONCURRENCY=5
CRAWL_INTERVAL_HOURS=4

# ── System portal accounts (encrypted at rest; shown here for local dev only) ─
NAUKRI_SYSTEM_EMAIL=
NAUKRI_SYSTEM_PASSWORD=
LINKEDIN_SYSTEM_EMAIL=
LINKEDIN_SYSTEM_PASSWORD=
GLASSDOOR_SYSTEM_EMAIL=
GLASSDOOR_SYSTEM_PASSWORD=
INDEED_SYSTEM_EMAIL=
INDEED_SYSTEM_PASSWORD=
