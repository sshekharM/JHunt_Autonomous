# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=change-me-to-a-random-64-char-hex-string
APP_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=jhans
POSTGRES_USER=jhans
POSTGRES_PASSWORD=change-me

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── MinIO ────────────────────────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me
MINIO_BUCKET_RESUMES=jhans-resumes
MINIO_SECURE=false

# ── Encryption ───────────────────────────────────────────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=change-me-generate-with-fernet

# ── OAuth Providers ──────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Microsoft External ID (inactive at launch — scaffold only)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=

# ── LLM ──────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ── Notifications ────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# Email (SendGrid or SMTP)
EMAIL_PROVIDER=smtp
SENDGRID_API_KEY=
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@jhans.local

# ── Security ─────────────────────────────────────────────────────────────────
# Comma-separated allowed IPs for system portal accounts
ALLOWED_IPS=127.0.0.1
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=8
TOTP_ISSUER=jH_ANS

# ── Crawling ─────────────────────────────────────────────────────────────────
CRAWL_MAX_CONCURRENCY=5
CRAWL_INTERVAL_HOURS=4

# ── System portal accounts (encrypted at rest; shown here for local dev only) ─
NAUKRI_SYSTEM_EMAIL=
NAUKRI_SYSTEM_PASSWORD=
LINKEDIN_SYSTEM_EMAIL=
LINKEDIN_SYSTEM_PASSWORD=
GLASSDOOR_SYSTEM_EMAIL=
GLASSDOOR_SYSTEM_PASSWORD=
INDEED_SYSTEM_EMAIL=
INDEED_SYSTEM_PASSWORD=
