{
  "name": "jhunt-autonomous",
  "description": "Python FastAPI job hunt automation, brownfield existing code, web UI + API",
  "stack": {
    "backend": {
      "language": "python",
      "version": "3.12",
      "framework": "fastapi",
      "package_manager": "pip",
      "linter": "ruff",
      "typechecker": "mypy",
      "test_runner": "pytest"
    },
    "frontend": null,
    "database": {
      "primary": "postgresql",
      "secondary": "redis"
    }
  },
  "lsp": {
    "servers": [
      {
        "language": "python",
        "server": "pyright",
        "binary": "pyright",
        "install": "npm i -g pyright"
      }
    ]
  },
  "evaluation": {
    "api_base_url": "http://localhost:8000",
    "health_check": "/api/health",
    "design_score_threshold": 7,
    "design_max_iterations": 10,
    "test_corpus_dir": "specs/test_artefacts"
  },
  "execution": {
    "default_mode": "full",
    "model_tier": "cost",
    "ceremony": "full",
    "session_chaining": true,
    "teammate_model": "sonnet",
    "// budget": "unset — /auto uses the model_tier default cap (cost tier ~= 80 agents / $8 / 30 min). To enforce a per-build ceiling, replace this key with  budget: { est_cost_usd, agents, wall_clock_ms }  — or pass --budget at run time. See docs/token-cost-playbook.md."
  },
  "verification": {
    "mode": "docker",
    "docker": {
      "compose_file": "docker-compose.yml",
      "services": [
        "db",
        "redis",
        "minio",
        "app",
        "worker",
        "beat"
      ]
    }
  },
  "topology": "api-service",
  "quality": {
    "sensor_tier": "standard",
    "agent_readiness": {
      "mode": "report",
      "min_active_pillars": 3,
      "forbid_regression": false
    },
    "sast_engine": "semgrep"
  },
  "token_governor": {
    "enabled": true,
    "mode": "enforced",
    "living_navigation": true,
    "context_search_required": true,
    "max_source_read_lines": 300,
    "tool_output_token_estimates": true,
    "compress_tool_output": true,
    "ccr_enabled": true,
    "preserve_full_outputs": true,
    "budget_warn_pct": 80
  },
  "observability": {
    "enabled": false,
    "metrics_path": "/metrics",
    "red_labels": [
      "method",
      "route",
      "status"
    ],
    "slo": {
      "error_rate_pct": 1,
      "p95_ms": 500
    },
    "_note": "No /metrics endpoint or Prometheus dependency exists yet; re-enable once added."
  },
  "framework_skill_packs": [
    "fastapi-code"
  ],
  "custom_sensors": [],
  "github": {
    "org": "",
    "default_branch": "main",
    "required_checks": [
      "gitleaks",
      "sast"
    ],
    "required_approvals": 1,
    "require_code_owner_review": true,
    "enforce_admins": true,
    "ruleset_scope": "org",
    "ruleset_name": "harness-baseline-protection",
    "target_repos": "~ALL",
    "default_owners": [
      "sshekharM"
    ],
    "environments": [
      {
        "name": "production",
        "reviewers": [],
        "wait_timer": 0,
        "protected_branches": true
      }
    ]
  },
  "harness_version": "3.0.0",
  "architecture": {
    "enabled": false
  }
}
